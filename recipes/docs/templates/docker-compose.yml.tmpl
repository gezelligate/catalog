  docs-minio:
    image: minio/minio:RELEASE.2024-12-18T13-15-44Z
    restart: unless-stopped
    environment:
      MINIO_ROOT_USER: "${DOCS_MINIO_ROOT_USER}"
      MINIO_ROOT_PASSWORD: "${DOCS_MINIO_ROOT_PASSWORD}"
    entrypoint: ""
    command: minio server --console-address :9001 /data
    volumes:
      - ./docs-minio-data:/data
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 5s
      timeout: 10s
      retries: 30

  docs-createbuckets:
    image: minio/mc:RELEASE.2024-11-21T17-21-54Z
    depends_on:
      docs-minio:
        condition: service_healthy
    entrypoint: ["/bin/sh", "-c"]
    # `mc anonymous set` is the public-bucket flag — we keep it private and
    # serve media through the backend's /api/v1.0/documents/media-auth/
    # endpoint, which the docs nginx ingress invokes via auth_request.
    command:
      - |
        mc alias set s3 http://docs-minio:9000 "$$DOCS_MINIO_ROOT_USER" "$$DOCS_MINIO_ROOT_PASSWORD" &&
        mc mb --ignore-existing s3/docs-media-storage &&
        mc version enable s3/docs-media-storage
    environment:
      DOCS_MINIO_ROOT_USER: "${DOCS_MINIO_ROOT_USER}"
      DOCS_MINIO_ROOT_PASSWORD: "${DOCS_MINIO_ROOT_PASSWORD}"

  docs-backend:
    image: lasuite/impress-backend:v3.7.0
    restart: unless-stopped
    depends_on:
      - {{db.host}}
      - {{redis.host}}
      - docs-createbuckets
      - keycloak
    environment:
      DJANGO_CONFIGURATION: Production
      DJANGO_SETTINGS_MODULE: impress.settings
      DJANGO_SECRET_KEY: "${DOCS_DJANGO_SECRET_KEY}"
      DJANGO_ALLOWED_HOSTS: "{{#if (eq global.mode "local")}}localhost{{else}}{{form.subdomain}}.{{global.baseDomain}}{{/if}}"
      LOGGING_LEVEL_HANDLERS_CONSOLE: ERROR
      LOGGING_LEVEL_LOGGERS_ROOT: INFO
      LOGGING_LEVEL_LOGGERS_APP: INFO
      PYTHONPATH: /app
      # Database (shared postgres)
      DB_HOST: {{db.host}}
      DB_PORT: "{{db.port}}"
      DB_NAME: {{db.name}}
      DB_USER: {{db.user}}
      DB_PASSWORD: "${DOCS_DB_PASSWORD}"
      # Redis (shared) — namespaced via key prefix at the application layer
      REDIS_URL: redis://{{redis.host}}:{{redis.port}}/3
      # Object storage (bundled minio). MEDIA_BASE_URL is the public URL the
      # frontend embeds; the backend signs URLs against AWS_S3_ENDPOINT_URL
      # (cluster-internal http) and the docs ingress proxies /media/* with
      # auth_request → backend → minio.
      AWS_S3_ENDPOINT_URL: http://docs-minio:9000
      AWS_S3_ACCESS_KEY_ID: "${DOCS_MINIO_ROOT_USER}"
      AWS_S3_SECRET_ACCESS_KEY: "${DOCS_MINIO_ROOT_PASSWORD}"
      AWS_STORAGE_BUCKET_NAME: docs-media-storage
      MEDIA_BASE_URL: "{{#if (eq global.mode "local")}}http://localhost:8083{{else}}https://{{form.subdomain}}.{{global.baseDomain}}{{/if}}"
      # OIDC — browser-facing endpoints use the public Keycloak URL so the
      # user's browser can reach them; server-side calls (token, userinfo,
      # jwks) go to the in-cluster keycloak Service.
      OIDC_OP_AUTHORIZATION_ENDPOINT: "{{#if (eq global.mode "local")}}http://localhost:8080{{else}}https://auth.{{global.baseDomain}}{{/if}}/realms/gezelligate/protocol/openid-connect/auth"
      OIDC_OP_LOGOUT_ENDPOINT: "{{#if (eq global.mode "local")}}http://localhost:8080{{else}}https://auth.{{global.baseDomain}}{{/if}}/realms/gezelligate/protocol/openid-connect/logout"
      OIDC_OP_TOKEN_ENDPOINT: http://keycloak:8080/realms/gezelligate/protocol/openid-connect/token
      OIDC_OP_USER_ENDPOINT: http://keycloak:8080/realms/gezelligate/protocol/openid-connect/userinfo
      OIDC_OP_JWKS_ENDPOINT: http://keycloak:8080/realms/gezelligate/protocol/openid-connect/certs
      OIDC_RP_CLIENT_ID: docs
      OIDC_RP_CLIENT_SECRET: "${DOCS_OIDC_CLIENT_SECRET}"
      OIDC_RP_SIGN_ALGO: RS256
      OIDC_RP_SCOPES: "openid email"
      LOGIN_REDIRECT_URL: "{{#if (eq global.mode "local")}}http://localhost:8083{{else}}https://{{form.subdomain}}.{{global.baseDomain}}{{/if}}"
      LOGIN_REDIRECT_URL_FAILURE: "{{#if (eq global.mode "local")}}http://localhost:8083{{else}}https://{{form.subdomain}}.{{global.baseDomain}}{{/if}}"
      LOGOUT_REDIRECT_URL: "{{#if (eq global.mode "local")}}http://localhost:8083{{else}}https://{{form.subdomain}}.{{global.baseDomain}}{{/if}}"
      OIDC_REDIRECT_ALLOWED_HOSTS: '["{{#if (eq global.mode "local")}}http://localhost:8083{{else}}https://{{form.subdomain}}.{{global.baseDomain}}{{/if}}"]'
      # Y-provider (collaboration server)
      Y_PROVIDER_API_BASE_URL: http://docs-y-provider:4444/api/
      Y_PROVIDER_API_KEY: "${DOCS_Y_PROVIDER_API_KEY}"
      COLLABORATION_API_URL: "{{#if (eq global.mode "local")}}http://localhost:8083{{else}}https://{{form.subdomain}}.{{global.baseDomain}}{{/if}}/collaboration/api/"
      COLLABORATION_BACKEND_BASE_URL: "{{#if (eq global.mode "local")}}http://localhost:8083{{else}}https://{{form.subdomain}}.{{global.baseDomain}}{{/if}}"
      COLLABORATION_SERVER_SECRET: "${DOCS_COLLABORATION_SERVER_SECRET}"
      COLLABORATION_SERVER_ORIGIN: "{{#if (eq global.mode "local")}}http://localhost:8083{{else}}https://{{form.subdomain}}.{{global.baseDomain}}{{/if}}"
      DJANGO_EMAIL_BRAND_NAME: "Docs"
      DJANGO_EMAIL_URL_APP: "{{#if (eq global.mode "local")}}http://localhost:8083{{else}}https://{{form.subdomain}}.{{global.baseDomain}}{{/if}}"

  docs-celery:
    image: lasuite/impress-backend:v3.7.0
    restart: unless-stopped
    command: ["celery", "-A", "impress.celery_app", "worker", "-l", "INFO"]
    depends_on:
      - docs-backend
    environment:
      DJANGO_CONFIGURATION: Production
      DJANGO_SETTINGS_MODULE: impress.settings
      DJANGO_SECRET_KEY: "${DOCS_DJANGO_SECRET_KEY}"
      PYTHONPATH: /app
      DB_HOST: {{db.host}}
      DB_PORT: "{{db.port}}"
      DB_NAME: {{db.name}}
      DB_USER: {{db.user}}
      DB_PASSWORD: "${DOCS_DB_PASSWORD}"
      REDIS_URL: redis://{{redis.host}}:{{redis.port}}/3
      AWS_S3_ENDPOINT_URL: http://docs-minio:9000
      AWS_S3_ACCESS_KEY_ID: "${DOCS_MINIO_ROOT_USER}"
      AWS_S3_SECRET_ACCESS_KEY: "${DOCS_MINIO_ROOT_PASSWORD}"
      AWS_STORAGE_BUCKET_NAME: docs-media-storage

  docs-y-provider:
    image: lasuite/impress-y-provider:v3.7.0
    restart: unless-stopped
    environment:
      Y_PROVIDER_API_KEY: "${DOCS_Y_PROVIDER_API_KEY}"
      COLLABORATION_SERVER_SECRET: "${DOCS_COLLABORATION_SERVER_SECRET}"
      COLLABORATION_SERVER_ORIGIN: "{{#if (eq global.mode "local")}}http://localhost:8083{{else}}https://{{form.subdomain}}.{{global.baseDomain}}{{/if}}"
      COLLABORATION_API_URL: "{{#if (eq global.mode "local")}}http://localhost:8083{{else}}https://{{form.subdomain}}.{{global.baseDomain}}{{/if}}/collaboration/api/"
      COLLABORATION_BACKEND_BASE_URL: "{{#if (eq global.mode "local")}}http://localhost:8083{{else}}https://{{form.subdomain}}.{{global.baseDomain}}{{/if}}"
      COLLABORATION_LOGGING: "true"

  # Public ingress for Docs. The lasuite/impress-frontend image is
  # nginx-unprivileged with the React build baked in (already serving on
  # port 3000). We override the entrypoint to drop our own server block
  # into /etc/nginx/conf.d/ and start nginx — the new block listens on
  # 8083 and routes /api, /admin, /collaboration/* and /media/* to the
  # right upstream. Hostnames are hardcoded to compose service names.
  docs:
    image: lasuite/impress-frontend:v3.7.0
    restart: unless-stopped
    user: "101"
    depends_on:
      - docs-backend
      - docs-y-provider
      - docs-minio
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        cat > /etc/nginx/conf.d/docs-ingress.conf <<'NGINX_EOF'
        upstream docs_backend {
            server docs-backend:8000 fail_timeout=0;
        }
        upstream docs_frontend {
            server 127.0.0.1:3000 fail_timeout=0;
        }
        upstream docs_yprovider {
            server docs-y-provider:4444 fail_timeout=0;
        }

        server {
            listen 8083;
            server_name _;
            charset utf-8;
            client_max_body_size 100m;
            server_tokens off;

            location @proxy_to_backend {
                proxy_set_header Host $$http_host;
                proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $$scheme;
                proxy_redirect off;
                proxy_pass http://docs_backend;
            }
            location @proxy_to_frontend {
                proxy_set_header Host $$http_host;
                proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $$scheme;
                proxy_redirect off;
                proxy_pass http://docs_frontend;
            }

            location / { try_files $$uri @proxy_to_frontend; }
            location /api { try_files $$uri @proxy_to_backend; }
            location /admin { try_files $$uri @proxy_to_backend; }
            location /external_api { try_files $$uri @proxy_to_backend; }
            location /static { try_files $$uri @proxy_to_backend; }

            location /collaboration/ws/ {
                proxy_http_version 1.1;
                proxy_set_header Upgrade $$http_upgrade;
                proxy_set_header Connection "Upgrade";
                proxy_pass http://docs_yprovider;
                proxy_read_timeout 86400;
                proxy_send_timeout 86400;
                proxy_set_header X-Forwarded-Proto $$scheme;
                proxy_set_header Origin $$http_origin;
                proxy_set_header Host $$host;
            }
            location /collaboration/api/ {
                proxy_pass http://docs_yprovider;
                proxy_set_header Host $$host;
            }

            location /media/ {
                auth_request /media-auth;
                auth_request_set $$authHeader $$upstream_http_authorization;
                auth_request_set $$authDate $$upstream_http_x_amz_date;
                auth_request_set $$authContentSha256 $$upstream_http_x_amz_content_sha256;

                proxy_set_header Authorization $$authHeader;
                proxy_set_header X-Amz-Date $$authDate;
                proxy_set_header X-Amz-Content-SHA256 $$authContentSha256;

                proxy_pass http://docs-minio:9000/docs-media-storage/;
                proxy_set_header Host docs-minio:9000;

                add_header Content-Security-Policy "default-src 'none'" always;
            }

            location /media-auth {
                proxy_pass http://docs_backend/api/v1.0/documents/media-auth/;
                proxy_set_header X-Forwarded-Proto $$scheme;
                proxy_set_header Host $$host;
                proxy_set_header X-Real-IP $$remote_addr;
                proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
                proxy_set_header X-Original-URL $$request_uri;

                proxy_pass_request_body off;
                proxy_set_header Content-Length "";
                proxy_set_header X-Original-Method $$request_method;
            }
        }
        NGINX_EOF
        exec nginx -g 'daemon off;'
{{#if (eq global.mode "local")}}
    ports:
      - "8083:8083"
{{/if}}
