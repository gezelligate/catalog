  drive-minio:
    image: minio/minio:RELEASE.2024-12-18T13-15-44Z
    restart: unless-stopped
    environment:
      MINIO_ROOT_USER: "${DRIVE_MINIO_ROOT_USER}"
      MINIO_ROOT_PASSWORD: "${DRIVE_MINIO_ROOT_PASSWORD}"
    entrypoint: ""
    command: minio server --console-address :9001 /data
    volumes:
      - ./drive-minio-data:/data
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 5s
      timeout: 10s
      retries: 30

  drive-createbuckets:
    image: minio/mc:RELEASE.2024-11-21T17-21-54Z
    depends_on:
      drive-minio:
        condition: service_healthy
    entrypoint: ["/bin/sh", "-c"]
    # Bucket stays private; user-facing media requests are gated by the
    # drive nginx ingress via auth_request → backend → minio (signed URLs).
    command:
      - |
        mc alias set s3 http://drive-minio:9000 "$$DRIVE_MINIO_ROOT_USER" "$$DRIVE_MINIO_ROOT_PASSWORD" &&
        mc mb --ignore-existing s3/drive-media-storage &&
        mc version enable s3/drive-media-storage
    environment:
      DRIVE_MINIO_ROOT_USER: "${DRIVE_MINIO_ROOT_USER}"
      DRIVE_MINIO_ROOT_PASSWORD: "${DRIVE_MINIO_ROOT_PASSWORD}"

  drive-backend:
    image: lasuite/drive-backend:v0.10.0
    restart: unless-stopped
    depends_on:
      {{db.host}}:
        condition: service_healthy
      {{redis.host}}:
        condition: service_healthy
      drive-createbuckets:
        condition: service_completed_successfully
      keycloak:
        condition: service_started
    environment:
      DJANGO_CONFIGURATION: Production
      DJANGO_SETTINGS_MODULE: drive.settings
      DJANGO_SECRET_KEY: "${DRIVE_DJANGO_SECRET_KEY}"
      DJANGO_ALLOWED_HOSTS: "{{#if (eq global.mode "local")}}localhost{{else}}{{form.subdomain}}.{{global.baseDomain}}{{/if}}"
      LOGGING_LEVEL_HANDLERS_CONSOLE: ERROR
      LOGGING_LEVEL_LOGGERS_ROOT: INFO
      LOGGING_LEVEL_LOGGERS_APP: INFO
      PYTHONPATH: /app
      # Database (shared postgres)
      DB_HOST: {{db.host}}
      DB_PORT: "{{db.port}}"
      DB_NAME: {{db.name}}
      DB_USER: {{db.user}}
      DB_PASSWORD: "${DRIVE_DB_PASSWORD}"
      # Celery / cache (shared redis, logical DB 4 — keeps keys from
      # colliding with meet=1 and docs=3).
      REDIS_URL: redis://{{redis.host}}:{{redis.port}}/4
      # Object storage (bundled minio). MEDIA_BASE_URL is the public URL
      # the frontend embeds; the backend signs URLs against
      # AWS_S3_ENDPOINT_URL (cluster-internal http) and the drive nginx
      # ingress proxies /media/* with auth_request → backend → minio.
      AWS_S3_ENDPOINT_URL: http://drive-minio:9000
      AWS_S3_ACCESS_KEY_ID: "${DRIVE_MINIO_ROOT_USER}"
      AWS_S3_SECRET_ACCESS_KEY: "${DRIVE_MINIO_ROOT_PASSWORD}"
      AWS_S3_REGION_NAME: us-east-1
      AWS_S3_SIGNATURE_VERSION: s3v4
      AWS_STORAGE_BUCKET_NAME: drive-media-storage
      MEDIA_BASE_URL: "{{#if (eq global.mode "local")}}http://localhost:8084{{else}}https://{{form.subdomain}}.{{global.baseDomain}}{{/if}}"
      # OIDC — browser-facing endpoints use the public Keycloak URL so the
      # user's browser can reach them; server-side calls (token, userinfo,
      # jwks) go to the in-cluster keycloak Service.
      OIDC_OP_AUTHORIZATION_ENDPOINT: "{{#if (eq global.mode "local")}}http://localhost:8080{{else}}https://auth.{{global.baseDomain}}{{/if}}/realms/gezelligate/protocol/openid-connect/auth"
      OIDC_OP_LOGOUT_ENDPOINT: "{{#if (eq global.mode "local")}}http://localhost:8080{{else}}https://auth.{{global.baseDomain}}{{/if}}/realms/gezelligate/protocol/openid-connect/logout"
      OIDC_OP_TOKEN_ENDPOINT: http://keycloak:8080/realms/gezelligate/protocol/openid-connect/token
      OIDC_OP_USER_ENDPOINT: http://keycloak:8080/realms/gezelligate/protocol/openid-connect/userinfo
      OIDC_OP_JWKS_ENDPOINT: http://keycloak:8080/realms/gezelligate/protocol/openid-connect/certs
      OIDC_RP_CLIENT_ID: drive
      OIDC_RP_CLIENT_SECRET: "${DRIVE_OIDC_CLIENT_SECRET}"
      OIDC_RP_SIGN_ALGO: RS256
      OIDC_RP_SCOPES: "openid email"
      LOGIN_REDIRECT_URL: "{{#if (eq global.mode "local")}}http://localhost:8084{{else}}https://{{form.subdomain}}.{{global.baseDomain}}{{/if}}"
      LOGIN_REDIRECT_URL_FAILURE: "{{#if (eq global.mode "local")}}http://localhost:8084{{else}}https://{{form.subdomain}}.{{global.baseDomain}}{{/if}}"
      LOGOUT_REDIRECT_URL: "{{#if (eq global.mode "local")}}http://localhost:8084{{else}}https://{{form.subdomain}}.{{global.baseDomain}}{{/if}}"
      OIDC_REDIRECT_ALLOWED_HOSTS: '["{{#if (eq global.mode "local")}}http://localhost:8084{{else}}https://{{form.subdomain}}.{{global.baseDomain}}{{/if}}"]'
      # WOPI is disabled in the MVP (Collabora / OnlyOffice are not bundled).
      # When you bundle either, set WOPI_CLIENTS and the matching
      # WOPI_<CLIENT>_DISCOVERY_URL + WOPI_SRC_BASE_URL.
      WOPI_CLIENTS: ""
      # Search indexer (Find app) is not bundled; disable indexed search.
      FEATURES_INDEXED_SEARCH: "False"
      DJANGO_EMAIL_BRAND_NAME: "Drive"
      DJANGO_EMAIL_URL_APP: "{{#if (eq global.mode "local")}}http://localhost:8084{{else}}https://{{form.subdomain}}.{{global.baseDomain}}{{/if}}"

  drive-celery:
    image: lasuite/drive-backend:v0.10.0
    restart: unless-stopped
    command: ["celery", "-A", "drive.celery_app", "worker", "-l", "INFO"]
    depends_on:
      - drive-backend
    environment:
      DJANGO_CONFIGURATION: Production
      DJANGO_SETTINGS_MODULE: drive.settings
      DJANGO_SECRET_KEY: "${DRIVE_DJANGO_SECRET_KEY}"
      PYTHONPATH: /app
      DB_HOST: {{db.host}}
      DB_PORT: "{{db.port}}"
      DB_NAME: {{db.name}}
      DB_USER: {{db.user}}
      DB_PASSWORD: "${DRIVE_DB_PASSWORD}"
      REDIS_URL: redis://{{redis.host}}:{{redis.port}}/4
      AWS_S3_ENDPOINT_URL: http://drive-minio:9000
      AWS_S3_ACCESS_KEY_ID: "${DRIVE_MINIO_ROOT_USER}"
      AWS_S3_SECRET_ACCESS_KEY: "${DRIVE_MINIO_ROOT_PASSWORD}"
      AWS_S3_REGION_NAME: us-east-1
      AWS_S3_SIGNATURE_VERSION: s3v4
      AWS_STORAGE_BUCKET_NAME: drive-media-storage

  drive-celery-beat:
    image: lasuite/drive-backend:v0.10.0
    restart: unless-stopped
    command:
      - celery
      - -A
      - drive.celery_app
      - beat
      - -l
      - INFO
      - --schedule=/tmp/celerybeat-schedule
    depends_on:
      - drive-backend
    environment:
      DJANGO_CONFIGURATION: Production
      DJANGO_SETTINGS_MODULE: drive.settings
      DJANGO_SECRET_KEY: "${DRIVE_DJANGO_SECRET_KEY}"
      PYTHONPATH: /app
      DB_HOST: {{db.host}}
      DB_PORT: "{{db.port}}"
      DB_NAME: {{db.name}}
      DB_USER: {{db.user}}
      DB_PASSWORD: "${DRIVE_DB_PASSWORD}"
      REDIS_URL: redis://{{redis.host}}:{{redis.port}}/4

  # Public ingress for Drive. The lasuite/drive-frontend image is
  # nginx-unprivileged with the static export of the Next.js build baked in
  # (listening on 8080). We replace its server block with one that listens
  # on 8084 and fans /api, /admin, /external_api and /media/* out to the
  # right upstream. Hostnames are hardcoded to compose service names.
  drive:
    image: lasuite/drive-frontend:v0.10.0
    restart: unless-stopped
    user: "101"
    depends_on:
      - drive-backend
      - drive-minio
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        cat > /etc/nginx/conf.d/default.conf <<'NGINX_EOF'
        upstream drive_backend {
            server drive-backend:8000 fail_timeout=0;
        }
        upstream drive_frontend {
            server 127.0.0.1:8080 fail_timeout=0;
        }

        server {
            listen 8084;
            server_name _;
            charset utf-8;
            client_max_body_size 100m;
            server_tokens off;

            location @proxy_to_backend {
                proxy_set_header Host $$http_host;
                proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $$scheme;
                proxy_redirect off;
                proxy_pass http://drive_backend;
            }
            location @proxy_to_frontend {
                proxy_set_header Host $$http_host;
                proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $$scheme;
                proxy_redirect off;
                proxy_pass http://drive_frontend;
            }

            location / { try_files $$uri @proxy_to_frontend; }
            location /api { try_files $$uri @proxy_to_backend; }
            location /admin { try_files $$uri @proxy_to_backend; }
            location /external_api { try_files $$uri @proxy_to_backend; }
            location /static { try_files $$uri @proxy_to_backend; }

            location /media/ {
                auth_request /media-auth;
                auth_request_set $$authHeader $$upstream_http_authorization;
                auth_request_set $$authDate $$upstream_http_x_amz_date;
                auth_request_set $$authContentSha256 $$upstream_http_x_amz_content_sha256;

                proxy_set_header Authorization $$authHeader;
                proxy_set_header X-Amz-Date $$authDate;
                proxy_set_header X-Amz-Content-SHA256 $$authContentSha256;

                proxy_pass http://drive-minio:9000/drive-media-storage/;
                proxy_set_header Host drive-minio:9000;

                add_header Content-Disposition "attachment";
            }

            # Inline preview (images, pdf) — same auth flow, no force-download.
            location /media/preview/ {
                auth_request /media-auth;
                auth_request_set $$authHeader $$upstream_http_authorization;
                auth_request_set $$authDate $$upstream_http_x_amz_date;
                auth_request_set $$authContentSha256 $$upstream_http_x_amz_content_sha256;

                proxy_set_header Authorization $$authHeader;
                proxy_set_header X-Amz-Date $$authDate;
                proxy_set_header X-Amz-Content-SHA256 $$authContentSha256;

                proxy_pass http://drive-minio:9000/drive-media-storage/;
                proxy_set_header Host drive-minio:9000;
            }

            location /media-auth {
                proxy_pass http://drive_backend/api/v1.0/items/media-auth/;
                proxy_set_header X-Forwarded-Proto $$scheme;
                proxy_set_header Host $$host;
                proxy_set_header X-Real-IP $$remote_addr;
                proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
                proxy_set_header X-Original-URL $$request_uri;

                proxy_pass_request_body off;
                proxy_set_header Content-Length "";
                proxy_set_header X-Original-Method $$request_method;
            }
        }
        NGINX_EOF
        exec nginx -g 'daemon off;'
{{#if (eq global.mode "local")}}
    ports:
      - "8084:8084"
{{/if}}
