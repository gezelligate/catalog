apiVersion: apps/v1
kind: Deployment
metadata:
  name: bridge
  namespace: gezelligate
spec:
  replicas: 1
  selector:
    matchLabels:
      app: bridge
  template:
    metadata:
      labels:
        app: bridge
    spec:
      containers:
        - name: bridge
          image: ghcr.io/spatialexplorers/bridge:latest
          ports:
            - containerPort: 8090
          # envFrom is processed FIRST so DB_PASSWORD (and friends) are
          # in the env. The DATABASE_URL below uses $(DB_PASSWORD)
          # which Kubernetes only expands when the referenced var is defined
          # in this same `env:` block — so we re-export it explicitly here
          # via valueFrom.secretKeyRef before consuming it.
          envFrom:
            - secretRef:
                name: bridge-env
          env:
            - name: NODE_ENV
              value: production
            - name: PORT
              value: "8090"
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: bridge-env
                  key: DB_PASSWORD
            - name: DATABASE_URL
              value: "postgres://{{db.user}}:$(DB_PASSWORD)@{{db.host}}:{{db.port}}/{{db.name}}"
            - name: OIDC_ISSUER
              value: "https://auth.{{global.baseDomain}}/realms/gezelligate"
            - name: OIDC_CLIENT_ID
              value: bridge
            - name: OIDC_REDIRECT_URI
              value: "https://{{global.baseDomain}}/auth/callback"
            - name: PUBLIC_BASE_URL
              value: "https://{{global.baseDomain}}"
            - name: BRIDGE_MANIFEST_PATH
              value: /app/manifest/bridge-manifest.json
          volumeMounts:
            - name: manifest
              mountPath: /app/manifest
              readOnly: true
            - name: icons
              mountPath: /app/icons
              readOnly: true
      # The bridge-manifest and bridge-icons ConfigMaps are emitted by the
      # engine renderer (run/src/renderer/targets/kubernetes.ts) into
      # configmaps/, not declared inline here, because they aggregate state
      # from every service that declares provides.bridge.
      volumes:
        - name: manifest
          configMap:
            name: bridge-manifest
        - name: icons
          configMap:
            name: bridge-icons
---
apiVersion: v1
kind: Service
metadata:
  name: bridge
  namespace: gezelligate
spec:
  selector:
    app: bridge
  ports:
    - port: 8090
      targetPort: 8090
