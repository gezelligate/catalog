variable "location" {
  type    = string
  default = "{{form.geography}}"
}

variable "control_plane_type" {
  type    = string
  default = "{{form.controlPlaneType}}"
}

variable "node_pool_type" {
  type    = string
  default = "{{form.nodePoolType}}"
}

variable "node_count" {
  type    = number
  default = {{form.nodeCount}}
}

# The SSH keypair is generated by gezelligate's deploy CLI on first run and
# stored under services/.ssh/. The CLI passes these paths in via -var flags.
variable "ssh_public_key" {
  type = string
}

variable "ssh_private_key_path" {
  type = string
}

# k3s cluster join token — generated-once and persisted in
# services/.secrets/k3s-token by the deploy CLI. Passed via TF_VAR_k3s_token.
variable "k3s_token" {
  type      = string
  sensitive = true
}
