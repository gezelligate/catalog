# Auto-generated by gezelligate. Edit cluster.yaml and re-render instead.
terraform {
  required_version = ">= 1.6.0"
  required_providers {
    scaleway = {
      source  = "scaleway/scaleway"
      version = "~> 2.47"
    }
  }
}

provider "scaleway" {
  region     = var.region
  project_id = var.project_id
}

resource "scaleway_k8s_cluster" "this" {
  name    = "gezelligate"
  version = "1.30"
  cni     = "cilium"
  type = "{{form.controlPlaneType}}"
  delete_additional_resources = true
}

resource "scaleway_k8s_pool" "default" {
  cluster_id  = scaleway_k8s_cluster.this.id
  name        = "default"
  node_type   = "{{form.nodePoolType}}"
  size = {{form.nodeCount}}
  autoscaling = false
  autohealing = true
}
