apiVersion: v1
kind: ConfigMap
metadata:
  name: livekit-config
  namespace: gezelligate
data:
  livekit.yaml: |
    port: 7880
    bind_addresses:
      - "0.0.0.0"
    redis:
      address: {{redis.host}}:{{redis.port}}
    rtc:
      tcp_port: 7881
      udp_port: 7882
      use_external_ip: true
    logging:
      level: info
---
apiVersion: v1
kind: Service
metadata:
  name: livekit
  namespace: gezelligate
spec:
  selector:
    app: livekit
  ports:
    - name: signaling
      port: 7880
      targetPort: 7880
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: livekit
  namespace: gezelligate
spec:
  replicas: 1
  selector:
    matchLabels:
      app: livekit
  template:
    metadata:
      labels:
        app: livekit
    spec:
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      # Kubernetes auto-injects LIVEKIT_PORT=tcp://<svc-ip>:7880 (and
      # friends) into every pod selected by a Service named `livekit`.
      # livekit-server reads LIVEKIT_PORT as its listen-port integer
      # flag, parses it, and crashes ("could not parse … as uint").
      # Disabling service-link env vars on this Pod restores sane env.
      enableServiceLinks: false
      containers:
        - name: livekit
          image: livekit/livekit-server:v1.11.0
          args: ["--config", "/etc/livekit/livekit.yaml"]
          env:
            - name: API_SECRET
              valueFrom:
                secretKeyRef:
                  name: livekit-env
                  key: API_SECRET
            - name: LIVEKIT_KEYS
              value: "livekit: $(API_SECRET)"
          ports:
            - containerPort: 7880
            - containerPort: 7881
            - containerPort: 7882
              protocol: UDP
          volumeMounts:
            - name: config
              mountPath: /etc/livekit
      volumes:
        - name: config
          configMap:
            name: livekit-config
