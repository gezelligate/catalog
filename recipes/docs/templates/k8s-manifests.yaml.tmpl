---
apiVersion: v1
kind: Service
metadata:
  name: docs-y-provider
  namespace: gezelligate
spec:
  selector:
    app: docs-y-provider
  ports:
    - port: 4444
      targetPort: 4444
---
# Public-facing nginx ingress. Routes /api → backend, /collaboration → y-provider,
# /media → minio (with auth_request through backend), everything else → frontend.
apiVersion: v1
kind: ConfigMap
metadata:
  name: docs-ingress-nginx
  namespace: gezelligate
data:
  docs-ingress.conf: |
    upstream docs_backend {
        server docs-backend:8000 fail_timeout=0;
    }
    upstream docs_frontend {
        server 127.0.0.1:3000 fail_timeout=0;
    }
    upstream docs_yprovider {
        server docs-y-provider:4444 fail_timeout=0;
    }

    server {
        listen 8083;
        server_name _;
        charset utf-8;
        client_max_body_size 100m;
        server_tokens off;

        location @proxy_to_backend {
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_redirect off;
            proxy_pass http://docs_backend;
        }
        location @proxy_to_frontend {
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_redirect off;
            proxy_pass http://docs_frontend;
        }

        location / { try_files $uri @proxy_to_frontend; }
        location /api { try_files $uri @proxy_to_backend; }
        location /admin { try_files $uri @proxy_to_backend; }
        location /external_api { try_files $uri @proxy_to_backend; }
        location /static { try_files $uri @proxy_to_backend; }

        location /collaboration/ws/ {
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "Upgrade";
            proxy_pass http://docs_yprovider;
            proxy_read_timeout 86400;
            proxy_send_timeout 86400;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_set_header Origin $http_origin;
            proxy_set_header Host $host;
        }
        location /collaboration/api/ {
            proxy_pass http://docs_yprovider;
            proxy_set_header Host $host;
        }

        location /media/ {
            auth_request /media-auth;
            auth_request_set $authHeader $upstream_http_authorization;
            auth_request_set $authDate $upstream_http_x_amz_date;
            auth_request_set $authContentSha256 $upstream_http_x_amz_content_sha256;

            proxy_set_header Authorization $authHeader;
            proxy_set_header X-Amz-Date $authDate;
            proxy_set_header X-Amz-Content-SHA256 $authContentSha256;

            proxy_pass http://docs-minio:9000/docs-media-storage/;
            proxy_set_header Host docs-minio:9000;

            add_header Content-Security-Policy "default-src 'none'" always;
        }

        location /media-auth {
            proxy_pass http://docs_backend/api/v1.0/documents/media-auth/;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Original-URL $request_uri;

            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header X-Original-Method $request_method;
        }
    }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: docs
  namespace: gezelligate
spec:
  replicas: 1
  selector:
    matchLabels:
      app: docs
  template:
    metadata:
      labels:
        app: docs
    spec:
      containers:
        - name: frontend
          image: lasuite/impress-frontend:v3.7.0
          ports:
            - containerPort: 8083
            - containerPort: 3000
          volumeMounts:
            - name: ingress-conf
              mountPath: /etc/nginx/conf.d/docs-ingress.conf
              subPath: docs-ingress.conf
              readOnly: true
      volumes:
        - name: ingress-conf
          configMap:
            name: docs-ingress-nginx
            items:
              - key: docs-ingress.conf
                path: docs-ingress.conf
---
apiVersion: v1
kind: Service
metadata:
  name: docs
  namespace: gezelligate
spec:
  selector:
    app: docs
  ports:
    - port: 8083
      targetPort: 8083
