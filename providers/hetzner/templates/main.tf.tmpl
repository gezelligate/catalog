# Auto-generated by gezelligate. Edit services/cluster.yaml and re-render instead.
#
# Provisions a minimal k3s cluster on Hetzner Cloud:
#   * 1 control-plane node (also schedulable — k3s default)
#   * {{form.nodeCount}} worker node(s)
#   * A private network for pod/node traffic
#   * An SSH key registered so you can troubleshoot later
# The Hetzner Cloud Controller Manager (CCM) is installed by ../install.sh
# after the cluster is up; that's what turns Service type=LoadBalancer into a
# real Hetzner Cloud Load Balancer.

terraform {
  required_version = ">= 1.6.0"
  required_providers {
    hcloud = {
      source  = "hetznercloud/hcloud"
      version = "~> 1.48"
    }
    null = {
      source  = "hashicorp/null"
      version = "~> 3.2"
    }
  }
}

provider "hcloud" {
  # Token is read from the HCLOUD_TOKEN env var, set by gezelligate's deploy CLI.
}

# The k3s join token is generated once by the deploy CLI and stored at
# services/.secrets/k3s-token; we receive it via TF_VAR_k3s_token. Keeping it
# out of Terraform state means tfstate loss doesn't invalidate the running
# cluster — existing workers have already joined with this value.

resource "hcloud_ssh_key" "gezelligate" {
  name       = "gezelligate"
  public_key = var.ssh_public_key
}

# Private network — so node <-> node traffic stays off the public internet.
resource "hcloud_network" "gezelligate" {
  name     = "gezelligate"
  ip_range = "10.0.0.0/16"
}

resource "hcloud_network_subnet" "nodes" {
  network_id   = hcloud_network.gezelligate.id
  type         = "cloud"
  network_zone = local.network_zone
  ip_range     = "10.0.1.0/24"
}

locals {
  # Hetzner physical location → network zone (required for the cloud subnet).
  zone_map = {
    fsn1 = "eu-central"
    nbg1 = "eu-central"
    hel1 = "eu-central"
    ash  = "us-east"
    hil  = "us-west"
  }
  network_zone = local.zone_map[var.location]
}

# ─── Control plane ─────────────────────────────────────────────────────────

resource "hcloud_server" "control_plane" {
  name        = "gezelligate-cp"
  image       = "ubuntu-24.04"
  server_type = var.control_plane_type
  location    = var.location
  ssh_keys    = [hcloud_ssh_key.gezelligate.id]

  public_net {
    ipv4_enabled = true
    ipv6_enabled = true
  }

  network {
    network_id = hcloud_network.gezelligate.id
    ip         = "10.0.1.2"
  }

  depends_on = [hcloud_network_subnet.nodes]

  user_data = <<-EOT
    #cloud-config
    packages:
      - curl
    write_files:
      - path: /root/install-k3s.sh
        permissions: '0755'
        content: |
          #!/bin/bash
          set -euxo pipefail
          # Wait until the private-network interface is up and has its 10.0.1.x address.
          for i in $(seq 1 60); do
            IFACE=$(ip -o -4 addr show to 10.0.0.0/16 | awk '{print $2}' | head -1 || true)
            if [ -n "$IFACE" ]; then break; fi
            sleep 2
          done
          PRIV_IP=$(ip -o -4 addr show dev "$IFACE" | awk '{print $4}' | cut -d/ -f1)
          PUB_IP=$(curl -s https://api.ipify.org || ip -o -4 addr show scope global | grep -v "$PRIV_IP" | awk '{print $4}' | cut -d/ -f1 | head -1)
          # --kube-apiserver-arg cloud-provider=... was removed in k8s 1.33+.
          # Only kubelet still accepts cloud-provider=external; the out-of-tree
          # CCM is wired up via the hcloud CCM Helm install (not a k3s flag).
          #
          # --disable-cloud-controller is CRITICAL. Without it, k3s's built-in
          # cloud controller runs FIRST and sets providerID=k3s://<hostname>
          # on every Node. Hetzner CCM then refuses to manage those nodes
          # (it only touches nodes with providerID=hcloud://...), so LBs end
          # up with zero targets and nothing is reachable from outside.
          curl -sfL https://get.k3s.io | \
            K3S_TOKEN='${var.k3s_token}' \
            INSTALL_K3S_EXEC="server \
              --disable traefik \
              --disable servicelb \
              --disable-cloud-controller \
              --write-kubeconfig-mode 644 \
              --tls-san $PUB_IP \
              --flannel-iface $IFACE \
              --node-ip $PRIV_IP \
              --node-external-ip $PUB_IP \
              --kubelet-arg cloud-provider=external" \
            sh -
    runcmd:
      - /root/install-k3s.sh
  EOT
}

# ─── Worker pool ───────────────────────────────────────────────────────────

resource "hcloud_server" "worker" {
  count       = var.node_count
  name        = "gezelligate-worker-${count.index + 1}"
  image       = "ubuntu-24.04"
  server_type = var.node_pool_type
  location    = var.location
  ssh_keys    = [hcloud_ssh_key.gezelligate.id]

  public_net {
    ipv4_enabled = true
    ipv6_enabled = true
  }

  network {
    network_id = hcloud_network.gezelligate.id
    ip         = "10.0.1.${10 + count.index}"
  }

  depends_on = [hcloud_server.control_plane, hcloud_network_subnet.nodes]

  user_data = <<-EOT
    #cloud-config
    packages:
      - curl
    write_files:
      - path: /root/install-k3s-agent.sh
        permissions: '0755'
        content: |
          #!/bin/bash
          set -euxo pipefail
          for i in $(seq 1 60); do
            IFACE=$(ip -o -4 addr show to 10.0.0.0/16 | awk '{print $2}' | head -1 || true)
            if [ -n "$IFACE" ]; then break; fi
            sleep 2
          done
          PRIV_IP=$(ip -o -4 addr show dev "$IFACE" | awk '{print $4}' | cut -d/ -f1)
          PUB_IP=$(curl -s https://api.ipify.org || ip -o -4 addr show scope global | grep -v "$PRIV_IP" | awk '{print $4}' | cut -d/ -f1 | head -1)
          # Wait for the control-plane API to accept connections.
          for i in $(seq 1 120); do
            if curl -sk https://10.0.1.2:6443/readyz >/dev/null; then break; fi
            sleep 5
          done
          curl -sfL https://get.k3s.io | \
            K3S_URL=https://10.0.1.2:6443 \
            K3S_TOKEN='${var.k3s_token}' \
            INSTALL_K3S_EXEC="agent \
              --flannel-iface $IFACE \
              --node-ip $PRIV_IP \
              --node-external-ip $PUB_IP \
              --kubelet-arg cloud-provider=external" \
            sh -
    runcmd:
      - /root/install-k3s-agent.sh
  EOT
}

# ─── Kubeconfig extraction ─────────────────────────────────────────────────
# k3s writes its kubeconfig to /etc/rancher/k3s/k3s.yaml with the server URL
# set to https://127.0.0.1:6443. We SCP it off, rewrite the URL to the CP's
# public IP, and drop it next to this state file. The deploy CLI picks it up.

resource "null_resource" "fetch_kubeconfig" {
  triggers = {
    cp_id = hcloud_server.control_plane.id
  }

  connection {
    type        = "ssh"
    host        = hcloud_server.control_plane.ipv4_address
    user        = "root"
    private_key = file(var.ssh_private_key_path)
  }

  provisioner "remote-exec" {
    inline = [
      "for i in $(seq 1 120); do [ -f /etc/rancher/k3s/k3s.yaml ] && break; sleep 5; done",
      "test -f /etc/rancher/k3s/k3s.yaml || (echo 'k3s never came up'; journalctl -u k3s --no-pager | tail -50; exit 1)"
    ]
  }

  provisioner "local-exec" {
    command = "scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -i ${var.ssh_private_key_path} root@${hcloud_server.control_plane.ipv4_address}:/etc/rancher/k3s/k3s.yaml ${path.module}/kubeconfig.raw && sed 's|https://127.0.0.1:6443|https://${hcloud_server.control_plane.ipv4_address}:6443|' ${path.module}/kubeconfig.raw > ${path.module}/kubeconfig.yaml && chmod 600 ${path.module}/kubeconfig.yaml && rm ${path.module}/kubeconfig.raw"
  }
}
