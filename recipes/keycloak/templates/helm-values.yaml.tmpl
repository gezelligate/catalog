# Auto-generated from gezelligate. Regenerated on every render.
replicaCount: 1

image:
  repository: quay.io/keycloak/keycloak
  tag: "25.0"

command:
  - "/opt/keycloak/bin/kc.sh"
  - "start"
  # Intentionally NO `--optimized` flag. The base quay.io/keycloak/keycloak
  # image is built WITHOUT DB drivers; drivers get pulled in during `kc.sh
  # build`, which `start` runs automatically when --optimized is absent.
  # With --optimized, Keycloak skips the build step and fails with "Driver
  # does not support the provided URL: jdbc:postgresql://..." because the
  # postgres driver isn't bundled in the stock image.
  - "--import-realm"
  # Canonical public URL used for the realm's `iss` claim and OIDC
  # discovery. Without this, Keycloak derives the issuer from each
  # request's Host header — so tokens minted via https://auth.<domain>
  # carry that issuer, but in-cluster services hitting
  # http://keycloak-keycloakx-http:8080 see a different one and reject
  # them ("Invalid token issuer. Expected …keycloak-keycloakx-http…").
  - "--hostname=https://auth.{{global.baseDomain}}"
  - "--hostname-strict=false"
  - "--http-enabled=true"
  - "--proxy-headers=xforwarded"
  - "--db=postgres"
  # Token exchange (RFC 8693) is a Tech Preview feature in Keycloak 25.
  # Bridge (and any future cross-service launcher) uses it to swap a
  # user's bridge session token for an audience-scoped token aimed at
  # mattermost / docs / meet, so APIs can be called on the user's
  # behalf without a second login. admin-fine-grained-authz is a hard
  # prerequisite because the renderer authorises bridge per-target via
  # client management permissions, which depend on that feature.
  - "--features=token-exchange,admin-fine-grained-authz"
  # Single-replica deploy — use in-memory local cache. Without this the chart
  # defaults to the `ispn` stack with DNS_PING, which requires a `dns_query`
  # property that the chart doesn't set → infinispan startup fails with
  # "dns_query can not be null or empty" and Keycloak crashloops.
  - "--cache=local"

# Disable the chart's automatic cache configuration. Otherwise the chart sets
# KC_CACHE=ispn + KC_CACHE_STACK=kubernetes as env vars, which take precedence
# over the --cache=local CLI arg, and Keycloak crashes trying to wire up
# JGroups DNS_PING (fails with "dns_query can not be null or empty").
cache:
  stack: custom

database:
  vendor: postgres
  hostname: {{db.host}}
  database: {{db.name}}
  username: {{db.user}}
  existingSecret: keycloak-env
  existingSecretKey: DB_PASSWORD

extraEnvFrom: |
  - secretRef:
      name: keycloak-env

# Bootstrap the initial admin user on first start. Without these, Keycloak
# 25+ refuses to let you create the admin over a public URL and shows
# "Local access required — You will need local access to create the
# administrative user". The secret key `ADMIN_PASSWORD` is generated by the
# renderer (service.yaml:secrets); the env var name `KEYCLOAK_ADMIN_PASSWORD`
# is what Keycloak 25 expects (Keycloak 26 renames this to
# `KC_BOOTSTRAP_ADMIN_PASSWORD` — update when we bump the image).
extraEnv: |
  - name: KEYCLOAK_ADMIN
    value: admin
  - name: KEYCLOAK_ADMIN_PASSWORD
    valueFrom:
      secretKeyRef:
        name: keycloak-env
        key: ADMIN_PASSWORD

extraVolumes: |
  - name: realm-import
    configMap:
      name: keycloak-realm-import
extraVolumeMounts: |
  - name: realm-import
    mountPath: /opt/keycloak/data/import

# NB: codecentric/keycloakx 3.0.0 does NOT bundle a postgres subchart — the
# `postgresql.enabled` key is inert. DB is provided by the shared `postgres`
# StatefulSet emitted inline by Gezelligate's k8s renderer (see
# repository/postgres/). Keycloak connects to the `postgres` ClusterIP Service
# on port 5432 using the `keycloak` role/database the shared init SQL created.

ingress:
  enabled: false

service:
  type: ClusterIP
  httpPort: 8080

# Chart defaults to `/auth` relative-path (Keycloak 16 legacy). We use root so
# URLs match our Mattermost OIDC config (https://auth.<domain>/realms/...) and
# the standard Keycloak 17+ layout.
http:
  relativePath: "/"
