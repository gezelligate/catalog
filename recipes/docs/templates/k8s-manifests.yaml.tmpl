              value: Production
            - name: DJANGO_SETTINGS_MODULE
              value: impress.settings
            - name: PYTHONPATH
              value: /app
            - name: DB_HOST
              value: {{db.host}}
            - name: DB_PORT
              value: "{{db.port}}"
            - name: DB_NAME
              value: {{db.name}}
            - name: DB_USER
              value: {{db.user}}
            - name: REDIS_URL
              value: "redis://{{redis.host}}:{{redis.port}}/3"
            - name: AWS_S3_ENDPOINT_URL
              value: "http://docs-minio:9000"
            - name: AWS_S3_ACCESS_KEY_ID
              valueFrom:
                secretKeyRef:
                  name: docs-env
                  key: MINIO_ROOT_USER
            - name: AWS_S3_SECRET_ACCESS_KEY
              valueFrom:
